{
  "info": {
    "name": "Сито API",
    "description": "API для полнотекстового поиска документов",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "👤 Users",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/register/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"securepass123\",\n  \"password2\": \"securepass123\",\n  \"first_name\": \"Иван\",\n  \"last_name\": \"Иванов\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/login/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"securepass123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/refresh/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/verify/",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{access_token}}\"\n}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/user/profile/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/user/logout/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📄 Documents",
      "item": [
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/documents/?page=1&page_size=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Document (JSON)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/documents/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rubrics\": [\"технологии\", \"python\", \"django\"],\n  \"text\": \"Django — это высокоуровневый веб-фреймворк для Python. Он способствует быстрой разработке и чистому, прагматичному дизайну.\",\n  \"is_public\": true\n}"
            }
          }
        },
        {
          "name": "Create Document (File Upload)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/documents/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "rubrics", "value": "технологии, python", "type": "text" },
                { "key": "is_public", "value": "true", "type": "text" },
                { "key": "file", "type": "file", "src": "/path/to/your/document.pdf" }
              ]
            }
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/documents/{{document_id}}/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Update Document",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/documents/{{document_id}}/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rubrics\": [\"обновлено\", \"новое\"],\n  \"text\": \"Обновлённый текст документа\",\n  \"is_public\": false\n}"
            }
          }
        },
        {
          "name": "Partial Update Document",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/documents/{{document_id}}/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_public\": true\n}"
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/documents/{{document_id}}/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "🔍 Search",
      "item": [
        {
          "name": "Search Documents",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/search/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"python разработка\",\n  \"rubric\": \"технологии\",\n  \"privacy\": \"all\",\n  \"page\": 1,\n  \"sort\": \"relevance\"\n}"
            }
          }
        },
        {
          "name": "Get Rubrics",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/rubrics/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Delete Search History Item",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/search/history/{{history_id}}/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "🔎 Retrieval (контракт)",
      "item": [
        {
          "name": "Retrieve chunks",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{consumer_token}}" }
            ],
            "url": "{{base_url}}/api/v1/search/retrieve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"как деплоить проект\",\n  \"limit\": 10,\n  \"rubrics\": []\n}"
            },
            "description": "Поиск отрывков для Семёна и лаптя (docs/SEARCH-CONTRACT.md). Токен потребителя, не JWT: `manage.py issue_api_token --name semen --scope service`. Кого искать — решает токен, поэтому `user_id` в теле запрещён (400). `query` — от 3 до 1000 знаков, `limit` — до 50. Пустой `results` при 200 значит «не нашлось», а не ошибку; 503 — поиск недоступен. Поле `score` в ответе всегда `null`, `source` говорит, чем нашли: hybrid, vector или fulltext."
          }
        }
      ]
    },
    {
      "name": "🏥 Monitoring",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/",
            "header": []
          }
        },
        {
          "name": "API Schema (OpenAPI)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/schema/",
            "header": []
          }
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/docs/",
            "header": []
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "consumer_token", "value": "", "type": "string" },
    { "key": "document_id", "value": "1", "type": "string" },
    { "key": "history_id", "value": "1", "type": "string" }
  ]
}
