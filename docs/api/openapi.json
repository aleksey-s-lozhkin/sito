                        "maxLength": 254
                    },
                    "first_name": {
                        "type": "string",
                        "title": "Имя",
                        "maxLength": 30
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Фамилия",
                        "maxLength": 30
                    },
                    "full_name": {
                        "type": "string",
