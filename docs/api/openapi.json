{
    "openapi": "3.0.3",
    "info": {
        "title": "Сито API",
        "version": "1.0.0",
        "description": "API для поиска по документам с аутентификацией"
    },
    "paths": {
        "/api/documents/": {
            "get": {
                "operationId": "documents_list",
                "description": "Получить список всех документов пользователя",
                "parameters": [
                    {
                        "name": "page",
                        "required": false,
                        "in": "query",
                        "description": "A page number within the paginated result set.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "tags": [
                    "documents"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedDocumentList"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "post": {
                "operationId": "documents_create",
                "description": "Создать новый документ (текст или файл)",
                "tags": [
                    "documents"
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "rubrics": {
                                        "type": "string",
                                        "description": "Рубрики через запятую",
                                        "example": "технологии, python, django"
                                    },
                                    "text": {
                                        "type": "string",
                                        "description": "Текст документа (если без файла)"
                                    },
                                    "is_public": {
                                        "type": "boolean",
                                        "description": "Публичный доступ",
                                        "default": false
                                    },
                                    "file": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "Файл (PDF, DOCX, XLSX, TXT)"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Document"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/documents/{id}/": {
            "get": {
                "operationId": "documents_retrieve",
                "description": "Получить документ по ID",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "documents"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Document"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "put": {
                "operationId": "documents_update",
                "description": "Обновить документ полностью",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "documents"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DocumentCreateUpdate"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/DocumentCreateUpdate"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Document"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "patch": {
                "operationId": "documents_partial_update",
                "description": "Частично обновить документ",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "documents"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedDocumentCreateUpdate"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedDocumentCreateUpdate"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Document"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "delete": {
                "operationId": "documents_destroy",
                "description": "Удалить документ",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "documents"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Документ удалён"
                    }
                }
            }
        },
        "/api/rubrics/": {
            "get": {
                "operationId": "rubrics_retrieve",
                "description": "Получить список всех рубрик из доступных пользователю документов",
                "tags": [
                    "search"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "description": "Список рубрик"
                    }
                }
            }
        },
        "/api/search/": {
            "post": {
                "operationId": "search_create",
                "description": "Полнотекстовый поиск по документам с фильтрацией",
                "tags": [
                    "search"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "query": {
                                        "type": "string",
                                        "description": "Поисковый запрос",
                                        "example": "python разработка"
                                    },
                                    "rubric": {
                                        "type": "string",
                                        "description": "Фильтр по рубрике",
                                        "example": "технологии"
                                    },
                                    "privacy": {
                                        "type": "string",
                                        "enum": [
                                            "all",
                                            "public",
                                            "private"
                                        ],
                                        "description": "Тип доступа",
                                        "default": "all"
                                    },
                                    "page": {
                                        "type": "integer",
                                        "description": "Номер страницы",
                                        "default": 1
                                    }
                                },
                                "required": [
                                    "query"
                                ]
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный поиск"
                    },
                    "400": {
                        "description": "Query parameter 'query' required"
                    },
                    "401": {
                        "description": "Не авторизован"
                    },
                    "429": {
                        "description": "Too many requests (30 per minute)"
                    }
                }
            }
        },
        "/api/search/history/{id}/": {
            "delete": {
                "operationId": "search_history_destroy",
                "description": "Удалить запись из истории поиска",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "integer"
                        },
                        "required": true
                    },
                    {
                        "in": "path",
                        "name": "pk",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "ID записи истории",
                        "required": true
                    }
                ],
                "tags": [
                    "search"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Удалено"
                    },
                    "404": {
                        "description": "Не найдено"
                    }
                }
            }
        },
        "/api/user/login/": {
            "post": {
                "operationId": "user_login_create",
                "description": "Авторизация пользователя (возвращает JWT токены)",
                "tags": [
                    "user"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "description": "Email пользователя",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "description": "Пароль",
                                        "example": "StrongPass123!"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешный вход, возвращены токены"
                    },
                    "401": {
                        "description": "Неверный email, пароль или email не подтверждён"
                    },
                    "429": {
                        "description": "Too many login attempts (10 per 5 minutes)"
                    }
                }
            }
        },
        "/api/user/logout/": {
            "post": {
                "operationId": "user_logout_create",
                "description": "Выход из системы (blacklist refresh токена)",
                "tags": [
                    "user"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "refresh"
                                ],
                                "properties": {
                                    "refresh": {
                                        "type": "string",
                                        "description": "Refresh токен (полученный при логине)",
                                        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {}
                ],
                "responses": {
                    "205": {
                        "description": "Токен успешно добавлен в blacklist"
                    },
                    "400": {
                        "description": "Refresh token required или Invalid token"
                    }
                }
            }
        },
        "/api/user/profile/": {
            "get": {
                "operationId": "user_profile_retrieve",
                "description": "Получить профиль текущего пользователя",
                "parameters": [
                    {
                        "in": "header",
                        "name": "Authorization",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Bearer JWT токен (например: Bearer eyJhbGciOiJIUzI1NiIs...)",
                        "required": true
                    }
                ],
                "tags": [
                    "user"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": "Профиль пользователя"
                    },
                    "401": {
                        "description": "Не авторизован"
                    },
                    "429": {
                        "description": "Too many requests (100 per minute)"
                    }
                }
            }
        },
        "/api/user/refresh/": {
            "post": {
                "operationId": "user_refresh_create",
                "description": "Обновление access токена по refresh токену",
                "tags": [
                    "user"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "refresh"
                                ],
                                "properties": {
                                    "refresh": {
                                        "type": "string",
                                        "description": "Refresh токен (полученный при логине)",
                                        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "description": "Новый access токен"
                    },
                    "400": {
                        "description": "Refresh token required или Invalid token"
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                }
            }
        },
        "/api/user/register/": {
            "post": {
                "operationId": "user_register_create",
                "description": "Регистрация нового пользователя",
                "tags": [
                    "user"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password",
                                    "password2"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "description": "Email пользователя",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "description": "Пароль (минимум 8 символов)",
                                        "example": "StrongPass123!"
                                    },
                                    "password2": {
                                        "type": "string",
                                        "format": "password",
                                        "description": "Подтверждение пароля",
                                        "example": "StrongPass123!"
                                    },
                                    "first_name": {
                                        "type": "string",
                                        "description": "Имя (опционально)",
                                        "example": "Иван"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "description": "Фамилия (опционально)",
                                        "example": "Иванов"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {}
                ],
                "responses": {
                    "201": {
                        "description": "Пользователь создан, отправлено письмо с подтверждением"
                    },
                    "400": {
                        "description": "Ошибка валидации"
                    },
                    "429": {
                        "description": "Too many registration attempts (3 per hour)"
                    }
                }
            }
        },
        "/api/user/verify/": {
            "post": {
                "operationId": "user_verify_create",
                "description": "Проверка валидности access токена",
                "tags": [
                    "user"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "token"
                                ],
                                "properties": {
                                    "token": {
                                        "type": "string",
                                        "description": "Access токен для проверки",
                                        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "description": "Токен валиден"
                    },
                    "401": {
                        "description": "Токен не валиден"
                    }
                }
            }
        },
        "/api/v1/search/retrieve": {
            "post": {
                "operationId": "v1_search_retrieve_create",
                "description": "Отдаёт отрывки документов, найденные по запросу. Кого искать — решает токен: служебный видит только публичные документы, персональный — свои и публичные. Пустой results при 200 означает «не нашлось»; 503 — поиск недоступен, и потребитель обязан сказать об этом, а не отвечать по памяти модели.",
                "summary": "Поиск отрывков документов",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RetrieveRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/RetrieveRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/RetrieveRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "ApiToken": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RetrieveResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Ошибка потребителя: запрос вне границ контракта"
                    },
                    "503": {
                        "description": "Поиск недоступен: Elasticsearch или индекс отрывков"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Document": {
                "type": "object",
                "description": "Сериализатор для документа (чтение)",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "rubrics": {},
                    "text": {
                        "type": "string",
                        "title": "Текст документа"
                    },
                    "created_date": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "is_public": {
                        "type": "boolean",
                        "title": "Публичный документ"
                    },
                    "file": {
                        "type": "string",
                        "format": "uri",
                        "readOnly": true,
                        "nullable": true
                    },
                    "file_name": {
                        "type": "string",
                        "readOnly": true
                    },
                    "file_type": {
                        "type": "string",
                        "readOnly": true
                    },
                    "text_source": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/TextSourceEnum"
                            }
                        ],
                        "readOnly": true,
                        "title": "Источник текста"
                    },
                    "user_email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true
                    },
                    "user_id": {
                        "type": "integer",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_date",
                    "file",
                    "file_name",
                    "file_type",
                    "id",
                    "text",
                    "text_source",
                    "user_email",
                    "user_id"
                ]
            },
            "DocumentCreateUpdate": {
                "type": "object",
                "description": "Сериализатор для создания и обновления документа",
                "properties": {
                    "rubrics": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "text": {
                        "type": "string",
                        "title": "Текст документа"
                    },
                    "is_public": {
                        "type": "boolean",
                        "title": "Публичный документ"
                    }
                },
                "required": [
                    "rubrics",
                    "text"
                ]
            },
            "PaginatedDocumentList": {
                "type": "object",
                "required": [
                    "count",
                    "results"
                ],
                "properties": {
                    "count": {
                        "type": "integer",
                        "example": 123
                    },
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=4"
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=2"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Document"
                        }
                    }
                }
            },
            "PatchedDocumentCreateUpdate": {
                "type": "object",
                "description": "Сериализатор для создания и обновления документа",
                "properties": {
                    "rubrics": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "text": {
                        "type": "string",
                        "title": "Текст документа"
                    },
                    "is_public": {
                        "type": "boolean",
                        "title": "Публичный документ"
                    }
                }
            },
            "RetrieveRequest": {
                "type": "object",
                "description": "Запрос поиска отрывков (контракт, §2).",
                "properties": {
                    "query": {
                        "type": "string",
                        "description": "Текст запроса, от 3 до 1000 знаков",
                        "maxLength": 1000,
                        "minLength": 3
                    },
                    "limit": {
                        "type": "integer",
                        "maximum": 50,
                        "minimum": 1,
                        "default": 10,
                        "description": "Сколько отрывков вернуть: по умолчанию 10, максимум 50"
                    },
                    "rubrics": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Сузить поиск до рубрик"
                    }
                },
                "required": [
                    "query"
                ]
            },
            "RetrieveResponse": {
                "type": "object",
                "description": "Ответ поиска отрывков.",
                "properties": {
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RetrieveResult"
                        }
                    },
                    "source": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/SourceEnum"
                            }
                        ],
                        "description": "Чем именно нашли: потребитель должен знать, что векторный поиск деградировал\n\n* `hybrid` - hybrid\n* `fulltext` - fulltext\n* `vector` - vector"
                    }
                },
                "required": [
                    "results",
                    "source"
                ]
            },
            "RetrieveResult": {
                "type": "object",
                "description": "Один отрывок (контракт, §3).",
                "properties": {
                    "document_id": {
                        "type": "integer"
                    },
                    "chunk_index": {
                        "type": "integer"
                    },
                    "chunk_total": {
                        "type": "integer"
                    },
                    "document_version": {
                        "type": "string",
                        "description": "Отпечаток содержимого: видно, что документ изменился"
                    },
                    "title": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string",
                        "description": "Отрывок целиком, с перехлёстом"
                    },
                    "score": {
                        "type": "number",
                        "format": "double",
                        "nullable": true,
                        "description": "Всегда null. Раньше здесь была шкала BM25, но с гибридным поиском выдача сливается по рангам (RRF): это сумма обратных мест, а не BM25 и не косинус. Число, которое ничего не значит, хуже его отсутствия — поэтому его нет."
                    },
                    "rubrics": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "is_public": {
                        "type": "boolean",
                        "description": "Можно ли пересказывать это всем"
                    }
                },
                "required": [
                    "chunk_index",
                    "chunk_total",
                    "document_id",
                    "document_version",
                    "is_public",
                    "rubrics",
                    "score",
                    "text",
                    "title"
                ]
            },
            "SourceEnum": {
                "enum": [
                    "hybrid",
                    "fulltext",
                    "vector"
                ],
                "type": "string",
                "description": "* `hybrid` - hybrid\n* `fulltext` - fulltext\n* `vector` - vector"
            },
            "TextSourceEnum": {
                "enum": [
                    "file",
                    "manual"
                ],
                "type": "string",
                "description": "* `file` - Из загруженного файла\n* `manual` - Ручной ввод"
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "email": {
                        "type": "string",
