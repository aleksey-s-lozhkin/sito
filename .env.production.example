# Пример окружения для продакшена.
#
# На сервере этот файл лежит как /srv/config/env/diploma.env с правами 600.
# Секретов в репозитории нет и быть не должно: значения ниже — заглушки,
# каждое берётся из хранилища паролей или генерируется.
#
#   cp .env.production.example /srv/config/env/diploma.env
#   chmod 600 /srv/config/env/diploma.env
#   nano /srv/config/env/diploma.env

# --- Django ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
# Домен и IP хоста: без IP запросы сканеров по адресу сыплют DisallowedHost.
#
# ПЕРЕХОДНЫЙ ПЕРИОД: здесь ОБА домена, новый и старый. Старый адрес отдаёт 301
# (deploy/nginx/docsearch-redirect.conf), но запрос с Host: docsearch... всё
# равно доходит до приложения — без него это DisallowedHost. Старое имя
# убирается отдельным шагом, когда владелец скажет: вместе с ним уйдут
# редирект-vhost и записи в трёх переменных ниже.
ALLOWED_HOSTS=sito.pyconstrictor.ru,docsearch.pyconstrictor.ru,95.54.44.225,localhost,127.0.0.1
# Оба origin по той же причине: пока старый домен жив, POST-формы на нём
# (вход, регистрация) обязаны проходить проверку CSRF.
CSRF_TRUSTED_ORIGINS=https://sito.pyconstrictor.ru,https://docsearch.pyconstrictor.ru
# Кому разрешено обращаться к API кросс-доменно. Здесь указывается origin
# вызывающего приложения, а не наш домен: собственный веб-интерфейс работает с
# того же origin. Если API использует другой проект, добавьте его адрес.
# Оба наших имени перечислены на переходный период, старый уйдёт вместе с
# редиректом.
CORS_ALLOWED_ORIGINS=https://sito.pyconstrictor.ru,https://docsearch.pyconstrictor.ru

# --- PostgreSQL (общий контейнер postgres в сети infra) ---
POSTGRES_DB=diploma
POSTGRES_USER=diploma
POSTGRES_PASSWORD=CHANGE_ME
DB_HOST=postgres
DB_PORT=5432

# --- Elasticsearch (общий контейнер elasticsearch в сети infra) ---
# Индекс documents принадлежит этому проекту. Поиск не критичен: запись
# документа не падает, если ES недоступен, — в /health/ready/ он будет degraded.
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# --- Redis (общий контейнер redis; база выбирается номером) ---
# Занято на хосте: /0 — Самогон (а раньше и diploma: cache.clear() одного
# проекта стирал бы ключи другого), /3 — лапот, /4 и /5 — Celery лапотя.
# /1 и /2 свободны, diploma занимает /1.
REDIS_URL=redis://redis:6379/1

# --- Email (подтверждение регистрации, сброс пароля) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=CHANGE_ME

# --- Модели Ollama ---
#
# Чат-модель: общая с лаптем и Самогоном, ОДНА загруженная модель на
# видеокарту 8 ГБ. Различия между приложениями задаются параметрами
# запроса, а не файлами моделей (lapot/docs/decisions/0010).
OLLAMA_URL=http://192.168.0.26:11434
OLLAMA_MODEL=qwen3:8b

# Модель эмбеддингов — ОТДЕЛЬНАЯ от чат-модели, и это нормально: она
# маленькая и с чат-моделью в 8 ГБ помещается.
#
# **`bge-m3`, а не `nomic-embed-text`.** Вторая англоязычная, а корпус и
# вопросы русские: она почти не различала русские синонимы. На `bge-m3`
# тот же гибрид дал 13/15 против 8/15.
#
# Размерность обязана совпадать с маппингом индекса: при смене модели
# нужна переиндексация (`reindex_chunks`, затем `embed_chunks`).
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIMS=1024

# Модель, которая ВИДИТ: нужна команде `describe_unreadable_documents` для
# документов без текстового слоя. Она вытесняет общую чат-модель на время
# работы (3,34 + 6,19 > 8 ГБ) — знать об этом надо.
OLLAMA_VISION_MODEL=gemma3:4b

OLLAMA_TIMEOUT_SECONDS=90
