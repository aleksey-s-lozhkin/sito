# Пример окружения для локальной разработки.
#
#   cp .env.example .env
#
# Для продакшена отдельный файл: .env.production.example (лежит на сервере как
# /srv/config/env/diploma.env). Секретов в репозитории нет.

# --- Django ---
DJANGO_SECRET_KEY=dev-secret-key-not-for-production
DJANGO_DEBUG=True
# Локальные адреса остаются: файл копируется в .env для разработки.
# Домены добавлены на переходный период, оба — новый и старый: пока старый
# адрес отдаёт 301 (deploy/nginx/docsearch-redirect.conf), запросы приходят с
# обоими именами, и без старого имени это DisallowedHost. Старое имя уйдёт
# отдельным шагом вместе с редиректом.
ALLOWED_HOSTS=localhost,127.0.0.1,sito.pyconstrictor.ru,docsearch.pyconstrictor.ru
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://sito.pyconstrictor.ru,https://docsearch.pyconstrictor.ru
# Тут же, а не только в прод-примере: так один и тот же набор имён виден в
# обоих файлах и не приходится вспоминать про третий список при переходе.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://sito.pyconstrictor.ru,https://docsearch.pyconstrictor.ru

# --- PostgreSQL ---
# Локально база поднимается из docker-compose.yml, тогда DB_HOST=db.
# При запуске без Docker — localhost.
POSTGRES_DB=docsearch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# --- Redis ---
# Номер базы на общем сервере закрепляется за проектом: diploma занимает /1,
# чтобы cache.clear() одного проекта не стирал ключи соседей.
REDIS_URL=redis://localhost:6379/1

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Модели Ollama ---
#
# Чат-модель: общая с лаптем и Самогоном, ОДНА загруженная модель на
# видеокарту 8 ГБ. Различия между приложениями задаются параметрами
# запроса, а не файлами моделей (lapot/docs/decisions/0010).
OLLAMA_URL=http://192.168.0.26:11434
OLLAMA_MODEL=qwen3:8b

# Модель эмбеддингов — ОТДЕЛЬНАЯ от чат-модели, и это нормально: она
# маленькая и с чат-моделью в 8 ГБ помещается.
#
# **`bge-m3`, а не `nomic-embed-text`.** Вторая англоязычная, а корпус и
# вопросы русские: она почти не различала русские синонимы. На `bge-m3`
# тот же гибрид дал 13/15 против 8/15.
#
# Размерность обязана совпадать с маппингом индекса: при смене модели
# нужна переиндексация (`reindex_chunks`, затем `embed_chunks`).
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIMS=1024

# Модель, которая ВИДИТ: нужна команде `describe_unreadable_documents` для
# документов без текстового слоя. Она вытесняет общую чат-модель на время
# работы (3,34 + 6,19 > 8 ГБ) — знать об этом надо.
OLLAMA_VISION_MODEL=gemma3:4b

OLLAMA_TIMEOUT_SECONDS=90
